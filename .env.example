# Sync (optional). Create a Supabase project, run supabase/schema.sql in its SQL editor,
# then copy the project URL and the anon (public) key from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where "Report a mistake" and the privacy policy send people (optional, but needed before launch).
NEXT_PUBLIC_CONTACT_EMAIL=
